---
import SectionHeader from '../ui/SectionHeader.astro';

const skills = [
  { category: 'Craft', items: ['TypeScript', 'Astro', 'Tailwind CSS', 'Go', 'Python'] },
  { category: 'Working with AI', items: ['Agentic workflows', 'Spec-driven development', 'Context & prompt design', 'Reviewing AI output'] },
  { category: 'How I work', items: ['Problem solving', 'Clear communication', 'Documentation', 'Security mindset', 'Continuous learning'] },
];
---

<section id="about" class="px-6 py-24">
  <div class="mx-auto max-w-4xl">
    <SectionHeader title="About" />

    <div class="grid gap-12 md:grid-cols-2">
      <!-- Bio -->
      <div class="space-y-5">
        <p class="text-[var(--color-text)] leading-relaxed">
          I'm a software engineer who likes to understand a problem end to end before
          writing code — from the interface down to the data underneath. I'd rather ship
          something small and well thought out than something big and fragile.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          AI agents are part of my daily toolkit: I write the spec, set the guardrails, and
          review what comes back. The craft is in asking good questions, checking the answers,
          and knowing when to take the wheel.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          I keep a personal knowledge base, document decisions as I go, and build side projects
          to learn in the open. I care about the unglamorous parts too — security, privacy and
          clean handoffs. Off the keyboard, you'll find me somewhere in the frontier, riding
          through the open world.
        </p>
      </div>

      <!-- Skills -->
      <div class="space-y-6">
        {skills.map(({ category, items }) => (
          <div>
            <h3 class="mb-2 font-heading text-xs tracking-widest uppercase text-[var(--color-accent-gold)]">
              {category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-sm text-[var(--color-text-muted)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
