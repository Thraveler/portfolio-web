---
import SectionHeader from '../ui/SectionHeader.astro';

const skills = [
  { category: 'Frontend', items: ['TypeScript', 'React', 'Astro', 'Tailwind CSS'] },
  { category: 'Backend', items: ['Node.js', 'Python', 'REST APIs', 'SQL'] },
  { category: 'AI & Tools', items: ['OpenAI API', 'LLM integration', 'Git', 'Docker'] },
];
---

<section id="about" class="px-6 py-24">
  <div class="mx-auto max-w-4xl">
    <SectionHeader title="About" />

    <div class="grid gap-12 md:grid-cols-2">
      <!-- Bio -->
      <div class="space-y-5">
        <p class="text-[var(--color-text)] leading-relaxed">
          I'm a Software Engineer who moves comfortably across the full stack —
          from crafting interfaces that feel natural to building the systems that power them.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          I care about writing code that lasts: readable, intentional, and built with the
          next person in mind. Whether working alone or in a team, I bring the same focus
          to every layer of the product.
        </p>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          When I'm not at the keyboard, you'll find me somewhere in the frontier —
          exploring what's next in AI, or riding through the open world.
        </p>
      </div>

      <!-- Skills -->
      <div class="space-y-6">
        {skills.map(({ category, items }) => (
          <div>
            <h3 class="mb-2 font-heading text-xs tracking-widest uppercase text-[var(--color-accent-gold)]">
              {category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-sm text-[var(--color-text-muted)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
