---
import type { ExperienceItem } from '../../data/experience';

type Props = ExperienceItem;

const { company, role, startDate, endDate, highlights } = Astro.props;

function formatDate(dateStr: string): string {
  const [year, month] = dateStr.split('-');
  const date = new Date(Number(year), Number(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const start = formatDate(startDate);
const end = endDate === 'present' ? 'Present' : formatDate(endDate);
---

<div class="relative pl-8 pb-10 last:pb-0">
  <!-- Timeline line -->
  <div class="absolute left-0 top-0 h-full w-px bg-[var(--color-border)] last:hidden"></div>
  <!-- Timeline dot -->
  <div class="absolute left-[-4px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-[var(--color-accent-gold)] bg-[var(--color-bg)]"></div>

  <div class="mb-1 flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-3">
    <h3 class="font-heading text-base font-semibold text-[var(--color-text)]">{role}</h3>
    <span class="text-[var(--color-accent-gold)] font-heading hidden sm:inline">·</span>
    <span class="font-heading text-sm text-[var(--color-accent-gold)]">{company}</span>
  </div>
  <p class="mb-3 text-xs text-[var(--color-text-muted)] font-heading tracking-wide">
    {start} — {end}
  </p>
  <ul class="space-y-1.5">
    {highlights.map((point) => (
      <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
        <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[var(--color-accent-red)]"></span>
        {point}
      </li>
    ))}
  </ul>
</div>
